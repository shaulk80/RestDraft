<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:RestDraft.UI.ViewModels"
        xmlns:views="using:RestDraft.UI.Views"
        x:Class="RestDraft.UI.Views.ExportSelectionWindow"
        x:DataType="vm:ExportSelectionViewModel"
        Title="Export collection"
        Width="520"
        Height="560"
        MinWidth="400"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" RowSpacing="8">
    <TextBlock Grid.Row="0" Text="Collection" />
    <ComboBox Grid.Row="1"
              HorizontalAlignment="Stretch"
              ItemsSource="{Binding Collections}"
              SelectedItem="{Binding SelectedCollection}"
              AutomationProperties.Name="Collection to export">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:CollectionChoice">
          <TextBlock Text="{Binding Name}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Border Grid.Row="2" Classes="panel">
      <views:SelectionTreeView DataContext="{Binding Tree}" />
    </Border>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8">
      <Button Content="Select all" Command="{Binding SelectAllCommand}" />
      <Button Content="Clear all" Command="{Binding ClearAllCommand}" />
    </StackPanel>
    <TextBlock Grid.Row="4" Text="{Binding Summary}" AutomationProperties.LiveSetting="Polite" />
    <TextBlock Grid.Row="5"
               Classes="warning"
               TextWrapping="Wrap"
               Text="Basic auth passwords and tokens are written to the file in plain text."
               IsVisible="{Binding HasCredentials}" />
    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Export" IsDefault="True" IsEnabled="{Binding CanExport}" Click="OnExportClick" />
      <Button Content="Cancel" IsCancel="True" Click="OnCancelClick" />
    </StackPanel>
  </Grid>
</Window>
