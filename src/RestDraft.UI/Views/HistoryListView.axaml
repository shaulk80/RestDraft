<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestDraft.UI.ViewModels"
             x:Class="RestDraft.UI.Views.HistoryListView"
             x:DataType="vm:HistoryListViewModel">
  <DockPanel Margin="8" LastChildFill="True">
    <!-- The search box, the method and the bodies option are in the filter popup of the top bar. -->
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8" Spacing="6">
      <Button Content="Restore"
              Command="{Binding RestoreCommand}"
              AutomationProperties.Name="Restore selected request" />
      <TextBlock Text="{Binding StatusMessage}"
                 Classes="error"
                 TextWrapping="Wrap" />
      <TextBlock Text="No history entry matches the filter."
                 TextWrapping="Wrap"
                 IsVisible="{Binding IsFilteredEmpty}" />
    </StackPanel>
    <ListBox ItemsSource="{Binding Items}"
             SelectedItem="{Binding SelectedItem}"
             AutomationProperties.Name="History">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:HistoryItemViewModel">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Url}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Details}" Opacity="0.7" />
          </StackPanel>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</UserControl>
