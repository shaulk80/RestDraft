<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:RestDraft.UI.ViewModels"
             xmlns:behaviors="using:RestDraft.UI.Behaviors"
             xmlns:controls="using:RestDraft.UI.Controls"
             x:Class="RestDraft.UI.Views.CollectionsTreeView"
             x:DataType="vm:CollectionsTreeViewModel">
  <Grid x:Name="ContentGrid">
    <DockPanel Margin="8" LastChildFill="True">
      <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="0,0,0,8">
        <Button Classes="tool"
                Command="{Binding NewCollectionCommand}"
                ToolTip.Tip="New collection"
                AutomationProperties.Name="New collection">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Path Data="{DynamicResource CollectionIconData}" />
            <TextBlock Text="+" />
          </StackPanel>
        </Button>
        <Button Classes="tool"
                Command="{Binding NewFolderCommand}"
                ToolTip.Tip="New folder in the selected collection or folder"
                AutomationProperties.Name="New folder">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Path Data="{DynamicResource FolderIconData}" />
            <TextBlock Text="+" />
          </StackPanel>
        </Button>
        <Button Classes="tool"
                Command="{Binding NewRequestCommand}"
                ToolTip.Tip="New request in the selected collection or folder"
                AutomationProperties.Name="New request">
          <StackPanel Orientation="Horizontal" Spacing="2">
            <Path Data="M3.5,1.5 H10 L13,4.5 V14.5 H3.5 Z M10,1.5 V4.5 H13" />
            <TextBlock Text="+" />
          </StackPanel>
        </Button>
      </StackPanel>
      <TextBlock DockPanel.Dock="Top"
                 Margin="0,0,0,8"
                 Text="Nothing matches the filter."
                 TextWrapping="Wrap"
                 IsVisible="{Binding IsFilteredEmpty}" />
      <controls:EditAwareTreeView x:Name="Tree"
                                  ItemsSource="{Binding Roots}"
                                  SelectedItem="{Binding SelectedNode}"
                                  AutomationProperties.Name="Collections">
        <TreeView.KeyBindings>
          <KeyBinding Gesture="F2" Command="{Binding RenameSelectedCommand}" />
          <KeyBinding Gesture="Enter" Command="{Binding OpenSelectedCommand}" />
        </TreeView.KeyBindings>
        <TreeView.Styles>
          <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="{ReflectionBinding IsExpanded, Mode=TwoWay}" />
          </Style>
          <!-- The expand and collapse button is the whole cell left of the row text, as high as the row, not only the
               small chevron. Fluent puts the button in a panel with a 12 px margin on each side, set in the template, so
               a style cannot remove it. The negative margin lets the button reach over it: it spans from the left edge of
               the row to the text, and the panel keeps its old size, so the text stays where it was. Fluent's template
               also sizes the border of the button to the glyph, so the button gets a template of its own. -->
          <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="Margin" Value="-12,0" />
            <Setter Property="Width" Value="52" />
            <Setter Property="Height" Value="NaN" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
              <ControlTemplate>
                <Border Background="Transparent">
                  <Path Name="ChevronPath"
                        Width="12"
                        Height="12"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stretch="Uniform"
                        Data="{DynamicResource TreeViewItemCollapsedChevronPathData}"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="1" />
                </Border>
              </ControlTemplate>
            </Setter>
          </Style>
          <Style Selector="TreeViewItem /template/ ToggleButton#PART_ExpandCollapseChevron:checked /template/ Path#ChevronPath">
            <Setter Property="Data" Value="{DynamicResource TreeViewItemExpandedChevronPathData}" />
          </Style>
          <!-- Fluent narrows the cell of the chevron of a row without children to 12 px, while the cell of a row with children
               is as wide as the chevron button above, so such a row starts one level too far left, and so do its own
               children. The cell keeps its normal width and the chevron stays in it, invisible and out of the way of the
               pointer and the Tab key, so every row of a level starts at the same place. -->
          <Style Selector="TreeViewItem:empty /template/ Panel#PART_ExpandCollapseChevronContainer">
            <Setter Property="Width" Value="NaN" />
          </Style>
          <Style Selector="TreeViewItem:empty /template/ ToggleButton#PART_ExpandCollapseChevron">
            <Setter Property="IsVisible" Value="True" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
          </Style>
          <!-- Collections and folders have an icon and text one size larger than the requests (14), so they stand out. -->
          <Style Selector="TextBlock.container">
            <Setter Property="FontSize" Value="15" />
          </Style>
          <Style Selector="Path.nodeIcon">
            <Setter Property="Stroke" Value="{Binding $parent[TreeViewItem].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
          </Style>
        </TreeView.Styles>
        <TreeView.DataTemplates>
          <TreeDataTemplate DataType="vm:TreeNodeViewModel" ItemsSource="{Binding Children}">
            <!-- Background makes the whole row hit-testable, so right-click works on blank row space too.
                 A TextBlock only hit-tests on its glyphs. -->
            <Grid Background="Transparent" AutomationProperties.Name="{Binding Name}">
              <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding !IsEditing}">
                <Path Classes="nodeIcon"
                      Data="{DynamicResource CollectionIconData}"
                      IsVisible="{Binding IsCollection}" />
                <Path Classes="nodeIcon"
                      Data="{DynamicResource FolderIconData}"
                      IsVisible="{Binding IsFolder}" />
                <TextBlock Classes.container="{Binding CanContainChildren}"
                           Text="{Binding Name}"
                           VerticalAlignment="Center" />
              </StackPanel>
              <TextBox behaviors:InPlaceEdit.CommitOnLostFocus="{Binding CommitRenameCommand}"
                       Text="{Binding EditName}"
                       AutomationProperties.Name="New name"
                       IsVisible="{Binding IsEditing}">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding CommitRenameCommand}" />
                  <KeyBinding Gesture="Escape" Command="{Binding CancelRenameCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
            </Grid>
          </TreeDataTemplate>
        </TreeView.DataTemplates>
      </controls:EditAwareTreeView>
    </DockPanel>
    <!-- Shows where a dragged node will land. The view places and shows it while a drag is over the tree. -->
    <Border x:Name="DropIndicatorBorder" />
    <!-- Not light-dismissable on purpose. Light dismiss swallows the first press outside the menu, so
         a right-click on another row would never reach the tree. The tree closes this menu itself. -->
    <Popup x:Name="MenuPopup"
           Placement="Pointer"
           IsLightDismissEnabled="False">
      <MenuFlyoutPresenter x:Name="MenuItems" x:DataType="vm:TreeNodeViewModel">
        <MenuItem Header="Open" Command="{Binding OpenCommand}" IsVisible="{Binding IsRequest}" />
        <MenuItem Header="New collection" Command="{Binding NewCollectionCommand}" IsVisible="{Binding IsCollection}" />
        <MenuItem Header="New folder" Command="{Binding NewFolderCommand}" IsVisible="{Binding CanContainChildren}" />
        <MenuItem Header="New request" Command="{Binding NewRequestCommand}" IsVisible="{Binding CanContainChildren}" />
        <MenuItem Header="Duplicate" Command="{Binding DuplicateCommand}" IsVisible="{Binding IsRequest}" />
        <MenuItem Header="Rename" Command="{Binding RenameCommand}" />
        <MenuItem Header="Delete" Command="{Binding DeleteCommand}" />
      </MenuFlyoutPresenter>
    </Popup>
  </Grid>
</UserControl>
